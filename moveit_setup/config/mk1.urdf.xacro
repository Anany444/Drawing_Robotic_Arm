<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mk1">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mk1 urdf file -->
    <xacro:include filename="$(find annin_ar4_description)/urdf/ar.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="mk1.ros2_control.xacro" />


    <xacro:mk1_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
